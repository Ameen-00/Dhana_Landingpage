# Copy to .env and fill in. .env is git-ignored — never commit real keys, never expose in the browser.

# ── Path A: real Sarvam voice in the on-site demos ──────────────────────────
# Sarvam Model API key (dashboard.sarvam.ai → Model APIs). Used only by
# scripts/generate-sarvam-voice.mjs to pre-generate the demo clips.
SARVAM_API_KEY=
# Optional Bulbul v3 voice for "Dhana" (default: anushka)
SARVAM_SPEAKER=anushka

# ── Path B: "Get a call from Dhana" live outbound (server/call-me.mjs) ───────
# Sarvam Voice-Agent credentials (apps.sarvam.ai). These place REAL phone calls.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://apps.sarvam.ai
PROVIDER_ORG_ID=
PROVIDER_WORKSPACE_ID=
PROVIDER_APP_ID=
PROVIDER_APP_VERSION=
PROVIDER_CONNECTION_ID=
PROVIDER_AGENT_PHONE_NUMBER=
# Local dev port for the call-me server (Vite proxies /api/call-me here)
CALL_ME_PORT=3001
