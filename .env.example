# Copy to .env and fill in. .env is git-ignored — never commit real keys, never expose in the browser.

# ── Which TTS provider renders the pre-recorded demo clips ───────────────────
# Global default is set in scripts/voice-config.mjs (currently: fish).
# Override here per run without editing code. Examples:
#   VOICE_PROVIDER=sarvam            # force everything to Sarvam
#   VOICE_PROVIDER_ML=sarvam         # only Malayalam on Sarvam
#   VOICE_PROVIDER_CALL=sarvam       # only the phone-call demo on Sarvam
# Leave blank to use the routing in voice-config.mjs.
VOICE_PROVIDER=

# ── Fish Audio voice for the on-site demos (scripts/generate-voices.mjs) ──────
# Fish Audio API key (fish.audio → API keys). One voice speaks every language,
# so Dhana's timbre stays identical across EN/HI/ML/TA.
FISH_API_KEY=
# reference_id of the "Dhana" voice model (fish.audio → your voices → copy the model id)
FISH_VOICE_DHANA=
# Optional: a male voice for the borrower in the call demo (falls back to the Dhana voice)
FISH_VOICE_BORROWER=
# Optional model: s1 (multilingual, default) | s2-pro | s2.1-pro
FISH_MODEL=s1

# ── Sarvam voice for the on-site demos (fallback / per-language) ──────────────
# Sarvam Model API key (dashboard.sarvam.ai → Model APIs).
SARVAM_API_KEY=
# Optional Bulbul v3 voice for "Dhana" (default: anushka)
SARVAM_SPEAKER=anushka

# ── Path B: "Get a call from Dhana" live outbound (server/call-me.mjs) ───────
# Sarvam Voice-Agent credentials (apps.sarvam.ai). These place REAL phone calls.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://apps.sarvam.ai
PROVIDER_ORG_ID=
PROVIDER_WORKSPACE_ID=
PROVIDER_APP_ID=
PROVIDER_APP_VERSION=
PROVIDER_CONNECTION_ID=
PROVIDER_AGENT_PHONE_NUMBER=
# Local dev port for the call-me server (Vite proxies /api/call-me here)
CALL_ME_PORT=3001
